{% layout none %}
{%- comment -%}
  Gift card page (the link Shopify emails to the recipient). A printed card
  in indigo with the balance, the code with a copy button, Apple Wallet, a
  print button and a link to start shopping. Self contained: no theme layout.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <meta name="robots" content="noindex">
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'section-content-pages.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="{% for scheme in settings.color_schemes limit: 1 %}color-{{ scheme.id }}{% endfor %}">
    <main class="gift-card page-width" id="MainContent">
      <a href="{{ shop.url }}" class="gift-card__brand heading-4">{{ shop.name }}</a>

      <div class="gift-card__card{% if gift_card.enabled == false or gift_card.expired %} is-expired{% endif %}">
        <p class="caption-3">{{ 'gift_card.card' | t }}</p>
        <p class="gift-card__balance display-2">{{ gift_card.balance | money_without_trailing_zeros }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_value = gift_card.initial_value | money_without_trailing_zeros -%}
          <p class="body-6">{{ 'gift_card.initial' | t: value: initial_value }}</p>
        {%- endif -%}
        <svg class="gift-card__fern" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
          <path d="M60 96c2-16 1-34-1-56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <g fill="currentColor">
            <ellipse cx="49" cy="82" rx="11" ry="3.8" transform="rotate(-30 49 82)"/>
            <ellipse cx="71" cy="80" rx="11" ry="3.8" transform="rotate(30 71 80)"/>
            <ellipse cx="50" cy="67" rx="10" ry="3.4" transform="rotate(-34 50 67)"/>
            <ellipse cx="69" cy="65" rx="10" ry="3.4" transform="rotate(34 69 65)"/>
            <ellipse cx="51" cy="53" rx="8" ry="3" transform="rotate(-38 51 53)"/>
            <ellipse cx="67" cy="51" rx="8" ry="3" transform="rotate(38 67 51)"/>
            <ellipse cx="59" cy="38" rx="2.8" ry="5.5"/>
          </g>
        </svg>
      </div>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="gift-card__notice body-4" role="status">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: '%e %B %Y' -%}
        <p class="body-6 text-muted">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <div class="gift-card__code">
        <label class="caption-1" for="GiftCardCode">{{ 'gift_card.code_label' | t }}</label>
        <div class="gift-card__code-row">
          <input class="field__input heading-6" id="GiftCardCode" type="text" value="{{ gift_card.code | format_code }}" readonly>
          <button type="button" class="button button--secondary" data-copy data-copied="{{ 'gift_card.copied' | t }}">{{ 'gift_card.copy' | t }}</button>
        </div>
        <p class="caption-2 text-muted">{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="visually-hidden" aria-live="polite" data-copy-status></p>
      </div>

      <div class="gift-card__actions">
        <a href="{{ shop.url }}" class="button">{{ 'gift_card.shop' | t }}</a>
        <button type="button" class="button button--secondary" data-print>{{ 'gift_card.print' | t }}</button>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="{{ 'gift_card.add_to_apple_wallet' | t }}" width="160" height="48">
          </a>
        {%- endif -%}
      </div>
    </main>

    <script>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
      document.querySelector('[data-copy]')?.addEventListener('click', async (event) => {
        const input = document.getElementById('GiftCardCode');
        try {
          await navigator.clipboard.writeText(input.value);
        } catch (error) {
          input.select();
          document.execCommand('copy');
        }
        document.querySelector('[data-copy-status]').textContent = event.currentTarget.dataset.copied;
        event.currentTarget.textContent = event.currentTarget.dataset.copied;
      });
    </script>
  </body>
</html>
