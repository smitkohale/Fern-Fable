[
  {
    "name": "theme_info",
    "theme_name": "Fern & Fable",
    "theme_version": "0.1.0",
    "theme_author": "Fern & Fable",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "t:settings.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon",
        "info": "t:settings.brand.favicon_info"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "t:settings.brand.share_image",
        "info": "t:settings.brand.share_image_info"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings.colors.background",
            "default": "#F5EFE4"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:settings.colors.surface",
            "default": "#EBE2D1"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings.colors.text",
            "default": "#1A1A22"
          },
          {
            "type": "color",
            "id": "heading",
            "label": "t:settings.colors.heading",
            "default": "#1C2754"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "t:settings.colors.muted",
            "default": "#5D5A66"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings.colors.accent",
            "default": "#A3302A"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.colors.button",
            "default": "#1C2754"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.colors.button_label",
            "default": "#F5EFE4"
          },
          {
            "type": "color",
            "id": "button_hover",
            "label": "t:settings.colors.button_hover",
            "default": "#121A3B"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:settings.colors.secondary_button",
            "default": "#1C2754"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings.colors.border",
            "default": "#D6CBB6"
          },
          {
            "type": "color",
            "id": "focus",
            "label": "t:settings.colors.focus",
            "default": "#1C2754"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button",
          "secondary_button_border": "secondary_button",
          "icons": "text",
          "links": "heading"
        }
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "label": "t:settings.layout.page_width",
        "default": 1440
      }
    ]
  },
  {
    "name": "t:settings.festive.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.festive.intro"
      },
      {
        "type": "checkbox",
        "id": "festive_mode",
        "label": "t:settings.festive.festive_mode",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.social.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.social.intro"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "t:settings.social.instagram",
        "placeholder": "https://instagram.com/"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "t:settings.social.pinterest",
        "placeholder": "https://pinterest.com/"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "t:settings.social.youtube",
        "placeholder": "https://youtube.com/"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "t:settings.social.facebook",
        "placeholder": "https://facebook.com/"
      }
    ]
  },
  {
    "name": "t:settings.whatsapp.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "whatsapp_show",
        "label": "t:settings.whatsapp.show",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "t:settings.whatsapp.number",
        "info": "t:settings.whatsapp.number_info",
        "placeholder": "919876543210"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "t:settings.whatsapp.message",
        "default": "Hi Fern & Fable, I have a question about"
      }
    ]
  },
  {
    "name": "t:settings.cart.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_open_on_add",
        "label": "t:settings.cart.open_on_add",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:settings.cart.free_shipping",
        "info": "t:settings.cart.free_shipping_info",
        "default": 1499
      }
    ]
  }
]
