{%- comment -%}
  404: a block that slipped while printing. A crooked double stamp of the
  fern block, a short apology in the brand voice, search, and a way back
  (home, all products, or the links from a chosen menu).
{%- endcomment -%}

{{ 'section-content-pages.css' | asset_url | stylesheet_tag }}
{{ 'section-search.css' | asset_url | stylesheet_tag }}

<div class="not-found full-width color-{{ section.settings.color_scheme }}">
  <div class="not-found__inner page-width">
    <div class="not-found__art" aria-hidden="true">
      {%- for layer in (1..2) -%}
        <svg class="not-found__stamp not-found__stamp--{{ layer }}" viewBox="0 0 120 120" focusable="false">
          <rect x="10" y="10" width="100" height="100" fill="none" stroke="currentColor" stroke-width="5"/>
          <rect x="21" y="21" width="78" height="78" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M60 96c2-16 1-34-1-56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <g fill="currentColor">
            <ellipse cx="49" cy="82" rx="11" ry="3.8" transform="rotate(-30 49 82)"/>
            <ellipse cx="71" cy="80" rx="11" ry="3.8" transform="rotate(30 71 80)"/>
            <ellipse cx="50" cy="67" rx="10" ry="3.4" transform="rotate(-34 50 67)"/>
            <ellipse cx="69" cy="65" rx="10" ry="3.4" transform="rotate(34 69 65)"/>
            <ellipse cx="51" cy="53" rx="8" ry="3" transform="rotate(-38 51 53)"/>
            <ellipse cx="67" cy="51" rx="8" ry="3" transform="rotate(38 67 51)"/>
            <ellipse cx="59" cy="38" rx="2.8" ry="5.5"/>
          </g>
        </svg>
      {%- endfor -%}
    </div>

    <div class="not-found__text">
      <p class="not-found__code display-1" aria-hidden="true">404</p>
      <h1 class="heading-2">{{ section.settings.heading }}</h1>
      <p class="body-3 text-muted">{{ section.settings.text }}</p>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form not-found__search">
        <label class="visually-hidden" for="NotFoundSearch">{{ 'search.predictive.label' | t }}</label>
        <input type="search" id="NotFoundSearch" name="q" class="search-page__input body-3" placeholder="{{ 'search.predictive.placeholder' | t }}">
        <button type="submit" class="button">{%- render 'icon', name: 'magnifying-glass' -%}{{ 'search.page.submit' | t }}</button>
      </form>

      <div class="not-found__actions">
        <a href="{{ routes.root_url }}" class="button">{{ 'cart.page.back_home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'cart.drawer.empty_cta_all' | t }}</a>
      </div>

      {%- if section.settings.menu.links.size > 0 -%}
        <nav aria-label="{{ 'general.not_found.suggestions' | t }}">
          <ul class="search-modal__chips" role="list">
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}" class="search-modal__chip body-5">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.404",
  "class": "section-404",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-kora" },
    { "type": "text", "id": "heading", "label": "t:sections.not_found.heading", "default": "This page slipped off the block" },
    { "type": "text", "id": "text", "label": "t:sections.not_found.text", "default": "The link may be old or mistyped. Search for what you were after, or head back to the table." },
    { "type": "link_list", "id": "menu", "label": "t:sections.not_found.menu", "default": "main-menu" }
  ]
}
{% endschema %}
