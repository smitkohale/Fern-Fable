{%- comment -%}
  Announcement bar: rotating messages above the header.
  Messages fade in turn, pause on hover and focus, and have a pause button
  (WCAG 2.2.2). Under reduced motion they do not rotate on their own.
  Messages marked "Festive only" show only while festive mode is on.
{%- endcomment -%}

{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar.js' | asset_url }}" type="module"></script>

{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.festive_only and settings.festive_mode == false
      continue
    endif
    if block.settings.text != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{%- if visible_blocks > 0 -%}
  <announcement-bar
    class="announcement-bar full-width color-{{ section.settings.color_scheme }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
    role="region"
    aria-label="{{ 'sections.announcement_bar.label' | t }}"
    aria-roledescription="{{ 'sections.announcement_bar.carousel' | t }}"
  >
    <div class="announcement-bar__inner page-width">
      {%- if visible_blocks > 1 -%}
        <button
          type="button"
          class="announcement-bar__control announcement-bar__prev"
          data-action="prev"
          aria-label="{{ 'sections.announcement_bar.previous' | t }}"
        >
          {%- render 'icon', name: 'caret-left' -%}
        </button>
      {%- endif -%}

      <div class="announcement-bar__track" aria-live="off">
        {%- assign slide_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.festive_only and settings.festive_mode == false -%}
            {%- continue -%}
          {%- endif -%}
          {%- if block.settings.text == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign slide_number = slide_index | plus: 1 -%}
          <div
            class="announcement-bar__slide caption-1{% if slide_index == 0 %} is-active{% endif %}"
            data-slide
            role="group"
            aria-roledescription="{{ 'sections.announcement_bar.slide' | t }}"
            aria-label="{{ 'sections.announcement_bar.slide_count' | t: index: slide_number, count: visible_blocks }}"
            {% if slide_index != 0 %}
              aria-hidden="true" inert
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">
                {{- block.settings.text -}}
                {%- render 'icon', name: 'arrow-right', class: 'announcement-bar__arrow' -%}
              </a>
            {%- else -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
          {%- assign slide_index = slide_index | plus: 1 -%}
        {%- endfor -%}
      </div>

      {%- if visible_blocks > 1 -%}
        <button
          type="button"
          class="announcement-bar__control announcement-bar__next"
          data-action="next"
          aria-label="{{ 'sections.announcement_bar.next' | t }}"
        >
          {%- render 'icon', name: 'caret-right' -%}
        </button>
        <button
          type="button"
          class="announcement-bar__control announcement-bar__toggle"
          data-action="toggle"
          aria-label="{{ 'sections.announcement_bar.pause' | t }}"
          data-label-pause="{{ 'sections.announcement_bar.pause' | t }}"
          data-label-play="{{ 'sections.announcement_bar.play' | t }}"
        >
          {%- render 'icon', name: 'pause', class: 'icon-pause' -%}
          {%- render 'icon', name: 'play', class: 'icon-play' -%}
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "section-announcement-bar",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "default": "scheme-indigo-deep"
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement_bar.interval",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement_bar.text",
          "default": "Free shipping over ₹1,499"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement_bar.link"
        },
        {
          "type": "checkbox",
          "id": "festive_only",
          "label": "t:sections.announcement_bar.festive_only",
          "info": "t:sections.announcement_bar.festive_only_info",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "The Festive Edit is here",
            "festive_only": true
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Free shipping over ₹1,499"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Free gift wrap on every order"
          }
        }
      ]
    }
  ]
}
{% endschema %}
