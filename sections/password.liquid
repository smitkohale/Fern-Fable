{%- comment -%}
  Password page (the store is not open yet). Big wordmark on deep indigo,
  the shop's password message, a signup for opening news, and the password
  entry tucked into a disclosure for the owner and invited guests.
{%- endcomment -%}

{{ 'section-content-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'newsletter-form.js' | asset_url }}" type="module"></script>

<div class="password-page full-width color-{{ section.settings.color_scheme }}">
  <div class="password-page__inner page-width">
    <p class="password-page__eyebrow caption-3">{{ 'password.opening_soon' | t }}</p>
    <h1 class="password-page__wordmark display-1">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password-page__message body-3">{{ shop.password_message }}</p>
    {%- else -%}
      <p class="password-page__message body-3">{{ section.settings.message }}</p>
    {%- endif -%}

    <div class="password-page__signup">
      {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
    </div>

    <div class="password-page__entry">
      <p class="body-5">{{ 'password.have_password' | t }}</p>
      {%- form 'storefront_password', class: 'password-page__form' -%}
        {%- if form.errors -%}
          <p class="password-page__error body-6" role="alert" id="PasswordError">{{ 'password.wrong' | t }}</p>
        {%- endif -%}
        <label class="caption-1" for="PasswordInput">{{ 'password.password' | t }}</label>
        <div class="password-page__row">
          <input
            class="field__input body-3"
            type="password"
            name="password"
            id="PasswordInput"
            autocomplete="current-password"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="PasswordError"
            {% endif %}
          >
          <button type="submit" class="button">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="caption-2 password-page__owner">{{ 'password.owner_html' | t: url: '/admin' }}</p>
    </div>

    <p class="password-page__demo caption-2">{{ section.settings.demo_note }}</p>
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "class": "section-password",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-indigo-deep" },
    { "type": "text", "id": "message", "label": "t:sections.password_page.message", "default": "Hand block printed linens for Indian tables. We open soon: leave your email and we will write the day the blocks start printing." },
    { "type": "text", "id": "demo_note", "label": "t:sections.password_page.demo_note", "default": "Demo store: a portfolio project. Fern & Fable is not a real brand." }
  ]
}
{% endschema %}
