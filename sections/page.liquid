{%- comment -%}
  Plain page (shipping, returns, any text page): title and the page content
  in a comfortable reading column. Richer pages (About) are built from the
  homepage sections in their own template.
{%- endcomment -%}

{{ 'section-content-pages.css' | asset_url | stylesheet_tag }}

<article class="page-content full-width color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="page-content__header">
      <h1 class="page-content__title heading-1">{{ page.title }}</h1>
    </header>
    <div class="page-content__body rte body-3">
      {{ page.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "t:general.page",
  "class": "section-page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-kora" }
  ],
  "presets": [{ "name": "t:general.page" }]
}
{% endschema %}
