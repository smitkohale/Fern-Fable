{%- comment -%}
  All collections (/collections). Every collection as a 4:5 tile with its
  photo, title and piece count, in the same style as "Start with a room".
{%- endcomment -%}

{{ 'section-collection-tiles.css' | asset_url | stylesheet_tag }}
{{ 'section-editorial.css' | asset_url | stylesheet_tag }}

<div class="collections-page full-width color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="blog__header">
      <p class="caption-3 text-muted">{{ 'collections.page.eyebrow' | t }}</p>
      <h1 class="blog__title display-2">{{ 'collections.title' | t }}</h1>
    </header>

    <ul class="collections-page__grid" role="list">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' or collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign number = forloop.index | prepend: '0' | slice: -2, 2 -%}
        <li>
          <a href="{{ collection.url }}" class="collection-tile">
            <div class="collection-tile__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    loading: 'lazy',
                    class: 'collection-tile__image',
                    alt: ''
                }}
              {%- else -%}
                {%- liquid
                  assign placeholder_number = forloop.index0 | modulo: 6 | plus: 1
                  assign placeholder = 'collection-' | append: placeholder_number
                -%}
                {{ placeholder | placeholder_svg_tag: 'collection-tile__placeholder' }}
              {%- endif -%}
              <span class="collection-tile__number caption-3" aria-hidden="true">{{ number }}</span>
            </div>
            <div class="collection-tile__info">
              <div class="collection-tile__text">
                <h2 class="collection-tile__title heading-4">{{ collection.title }}</h2>
                <p class="collection-tile__caption body-6 text-muted">{{ 'sections.collection_tiles.count' | t: count: collection.products_count }}</p>
              </div>
              <span class="collection-tile__arrow" aria-hidden="true">{%- render 'icon', name: 'arrow-right' -%}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:general.collections_grid",
  "class": "section-collections",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-kora" }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
