{%- comment -%}
  Contact page: a short intro and ways to reach the shop beside Shopify's
  contact form. Fields: name, email (required), phone, order number, message
  (required). <validated-form> shows specific inline errors before sending;
  Shopify's own errors and the success message show after.
{%- endcomment -%}

{{ 'section-content-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'validated-form.js' | asset_url }}" type="module"></script>

<div class="contact full-width color-{{ section.settings.color_scheme }}">
  <div class="contact__inner page-width">
    <div class="contact__intro">
      <h1 class="heading-1">{{ page.title | default: section.settings.heading }}</h1>
      {%- if page.content != blank -%}
        <div class="rte body-3 text-muted">{{ page.content }}</div>
      {%- elsif section.settings.text != blank -%}
        <p class="body-3 text-muted">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.details != blank -%}
        <div class="contact__details rte body-5">{{ section.settings.details }}</div>
      {%- endif -%}
    </div>

    <validated-form class="contact__form-wrap">
      {%- form 'contact', id: 'ContactForm', class: 'contact__form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact__success body-4" role="status" tabindex="-1" data-focus-on-load>
            {%- render 'icon', name: 'check' -%}
            {{ 'contact.success' | t }}
          </p>
        {%- elsif form.errors -%}
          <div class="contact__errors body-6" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="contact__row">
          <div class="field">
            <label class="field__label caption-1" for="ContactName">{{ 'contact.name' | t }}</label>
            <input class="field__input body-3" type="text" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}">
          </div>
          <div class="field">
            <label class="field__label caption-1" for="ContactEmail">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
            <input class="field__input body-3" type="email" id="ContactEmail" name="contact[email]" autocomplete="email" spellcheck="false" required value="{{ form.email }}" aria-describedby="ContactEmail-error" data-error-required="{{ 'contact.error_email_required' | t }}" data-error-email="{{ 'newsletter.error_email' | t }}">
            <p class="field__error body-6" id="ContactEmail-error" hidden></p>
          </div>
        </div>
        <div class="contact__row">
          <div class="field">
            <label class="field__label caption-1" for="ContactPhone">{{ 'contact.phone' | t }}</label>
            <input class="field__input body-3" type="tel" id="ContactPhone" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          <div class="field">
            <label class="field__label caption-1" for="ContactOrder">{{ 'contact.order' | t }}</label>
            <input class="field__input body-3" type="text" id="ContactOrder" name="contact[order number]" value="{{ form['order number'] }}" placeholder="#1001">
          </div>
        </div>
        <div class="field">
          <label class="field__label caption-1" for="ContactMessage">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
          <textarea class="field__input body-3" id="ContactMessage" name="contact[body]" rows="6" required aria-describedby="ContactMessage-error" data-error-required="{{ 'contact.error_message_required' | t }}">{{ form.body }}</textarea>
          <p class="field__error body-6" id="ContactMessage-error" hidden></p>
        </div>
        <p class="caption-2 text-muted">{{ 'contact.required_note' | t }}</p>
        <button type="submit" class="button contact__submit">{{ 'contact.submit' | t }}</button>
      {%- endform -%}
    </validated-form>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact.name",
  "class": "section-contact",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-kora" },
    { "type": "text", "id": "heading", "label": "t:sections.contact.heading", "default": "Say hello" },
    { "type": "text", "id": "text", "label": "t:sections.contact.text", "default": "Questions about a print, a gift, or an order? We answer within one working day." },
    { "type": "richtext", "id": "details", "label": "t:sections.contact.details", "default": "<p><strong>Hours</strong><br>Monday to Saturday, 10 am to 6 pm IST</p>" }
  ],
  "presets": [{ "name": "t:sections.contact.name" }]
}
{% endschema %}
