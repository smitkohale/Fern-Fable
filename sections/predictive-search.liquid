{%- comment -%}
  Predictive search results. Never placed on a page: assets/predictive-search.js
  fetches it from /search/suggest with section_id=predictive-search and puts
  the HTML into the search overlay. Every link is a listbox option so arrow
  keys can move through suggestions, products, collections and pages.
{%- endcomment -%}

{%- if predictive_search.performed -%}
  {%- liquid
    assign resources = predictive_search.resources
    assign total = resources.products.size | plus: resources.collections.size | plus: resources.pages.size | plus: resources.queries.size
    assign option_index = 0
    assign terms_escaped = predictive_search.terms | escape
  -%}
  <div class="predictive" data-predictive-results data-count="{{ resources.products.size }}">
    {%- if total > 0 -%}
      <div class="predictive__columns">
        {%- if resources.queries.size > 0 or resources.collections.size > 0 or resources.pages.size > 0 -%}
          <div class="predictive__side">
            {%- if resources.queries.size > 0 -%}
              <div class="predictive__group" role="group" aria-label="{{ 'search.predictive.suggestions' | t }}">
                <p class="predictive__heading caption-3" aria-hidden="true">{{ 'search.predictive.suggestions' | t }}</p>
                <ul class="predictive__list" role="presentation">
                  {%- for query in resources.queries -%}
                    {%- assign option_index = option_index | plus: 1 -%}
                    <li role="presentation">
                      <a href="{{ query.url }}" class="predictive__option predictive__query body-5" role="option" aria-selected="false" id="PredictiveOption-{{ option_index }}">
                        {%- render 'icon', name: 'magnifying-glass' -%}
                        <span>{{ query.styled_text }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if resources.collections.size > 0 -%}
              <div class="predictive__group" role="group" aria-label="{{ 'search.predictive.collections' | t }}">
                <p class="predictive__heading caption-3" aria-hidden="true">{{ 'search.predictive.collections' | t }}</p>
                <ul class="predictive__list" role="presentation">
                  {%- for collection in resources.collections -%}
                    {%- assign option_index = option_index | plus: 1 -%}
                    <li role="presentation">
                      <a href="{{ collection.url }}" class="predictive__option body-5" role="option" aria-selected="false" id="PredictiveOption-{{ option_index }}">
                        {{- collection.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if resources.pages.size > 0 -%}
              <div class="predictive__group" role="group" aria-label="{{ 'search.predictive.pages' | t }}">
                <p class="predictive__heading caption-3" aria-hidden="true">{{ 'search.predictive.pages' | t }}</p>
                <ul class="predictive__list" role="presentation">
                  {%- for page in resources.pages -%}
                    {%- assign option_index = option_index | plus: 1 -%}
                    <li role="presentation">
                      <a href="{{ page.url }}" class="predictive__option body-5" role="option" aria-selected="false" id="PredictiveOption-{{ option_index }}">
                        {{- page.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if resources.products.size > 0 -%}
          <div class="predictive__group predictive__products" role="group" aria-label="{{ 'search.predictive.products' | t }}">
            <p class="predictive__heading caption-3" aria-hidden="true">{{ 'search.predictive.products' | t }}</p>
            <ul class="predictive__product-list" role="presentation">
              {%- for product in resources.products -%}
                {%- assign option_index = option_index | plus: 1 -%}
                <li role="presentation">
                  <a href="{{ product.url }}" class="predictive__option predictive__product" role="option" aria-selected="false" id="PredictiveOption-{{ option_index }}">
                    <span class="predictive__thumb">
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '64px', loading: 'lazy', alt: '' }}
                      {%- endif -%}
                    </span>
                    <span class="predictive__product-text">
                      <span class="title-4">{{ product.title }}</span>
                      <span class="body-6 text-muted">
                        {%- if product.price_varies -%}
                          {%- assign price_from = product.price_min | money_without_trailing_zeros -%}
                          {{ 'products.card.from' | t: price: price_from }}
                        {%- else -%}
                          {{ product.price | money_without_trailing_zeros }}
                        {%- endif -%}
                      </span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="predictive__empty body-5" aria-hidden="true">{{ 'search.predictive.none' | t: terms: terms_escaped }}</p>
    {%- endif -%}

    {%- assign option_index = option_index | plus: 1 -%}
    <a
      href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last"
      class="predictive__option predictive__all body-4"
      role="option"
      aria-selected="false"
      id="PredictiveOption-{{ option_index }}"
    >
      {{- 'search.predictive.search_for' | t: terms: terms_escaped -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.predictive_search.name"
}
{% endschema %}
