{%- comment -%}
  Image with text: a 4:5 photo beside a numbered caption, heading, text and an
  optional link. Photo left or right; stacks on phones. The photo inks in,
  the text rises. Without a photo, a block printed motif panel stands in.
{%- endcomment -%}

{{ 'section-editorial.css' | asset_url | stylesheet_tag }}

<div class="image-text full-width color-{{ section.settings.color_scheme }}{% if section.settings.image_position == 'right' %} image-text--reverse{% endif %}">
  <div class="image-text__inner page-width">
    <div class="image-text__media" data-reveal="ink">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            class: 'image-text__image'
        }}
      {%- else -%}
        <div class="image-text__motif" aria-hidden="true">
          <svg viewBox="0 0 120 120" focusable="false">
            <rect x="10" y="10" width="100" height="100" fill="none" stroke="currentColor" stroke-width="4"/>
            <rect x="20" y="20" width="80" height="80" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M60 96c2-16 1-34-1-56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <g fill="currentColor">
              <ellipse cx="49" cy="82" rx="11" ry="3.8" transform="rotate(-30 49 82)"/>
              <ellipse cx="71" cy="80" rx="11" ry="3.8" transform="rotate(30 71 80)"/>
              <ellipse cx="50" cy="67" rx="10" ry="3.4" transform="rotate(-34 50 67)"/>
              <ellipse cx="69" cy="65" rx="10" ry="3.4" transform="rotate(34 69 65)"/>
              <ellipse cx="51" cy="53" rx="8" ry="3" transform="rotate(-38 51 53)"/>
              <ellipse cx="67" cy="51" rx="8" ry="3" transform="rotate(38 67 51)"/>
              <ellipse cx="59" cy="38" rx="2.8" ry="5.5"/>
            </g>
          </svg>
        </div>
      {%- endif -%}
    </div>

    <div class="image-text__text" data-reveal="rise">
      {%- if section.settings.number != blank -%}
        <p class="image-text__number display-2" aria-hidden="true">{{ section.settings.number }}</p>
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="caption-3 text-muted">{{ section.settings.caption }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="image-text__heading heading-2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte body-3 image-text__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="image-text__link body-2">
          {{- section.settings.link_label -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_text.name",
  "class": "section-image-text",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-kora" },
    { "type": "image_picker", "id": "image", "label": "t:sections.image_text.image" },
    {
      "type": "select", "id": "image_position", "label": "t:sections.image_text.image_position", "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ]
    },
    { "type": "text", "id": "number", "label": "t:sections.image_text.number", "info": "t:sections.image_text.number_info" },
    { "type": "text", "id": "caption", "label": "t:sections.image_text.caption" },
    { "type": "text", "id": "heading", "label": "t:sections.image_text.heading", "default": "Printed by hand" },
    { "type": "richtext", "id": "text", "label": "t:sections.image_text.text", "default": "<p>Every length of cloth is stamped one block at a time.</p>" },
    { "type": "text", "id": "link_label", "label": "t:sections.image_text.link_label" },
    { "type": "url", "id": "link", "label": "t:sections.image_text.link" }
  ],
  "presets": [{ "name": "t:sections.image_text.name" }]
}
{% endschema %}
