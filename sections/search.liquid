{%- comment -%}
  Search results page. Search form, result count, products as product cards
  and pages or articles as simple rows, page links, and helpful empty states
  (nothing searched yet, or no results).
{%- endcomment -%}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'section-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" type="module"></script>

{%- assign terms_escaped = search.terms | escape -%}

<div class="search-page full-width color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="search-page__header">
      <h1 class="search-page__title heading-1">
        {%- if search.performed -%}
          {{ 'search.page.results_title' | t }}
        {%- else -%}
          {{ 'search.page.title' | t }}
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label class="visually-hidden" for="SearchPageInput">{{ 'search.predictive.label' | t }}</label>
        <input
          type="search"
          id="SearchPageInput"
          class="search-page__input body-3"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.predictive.placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">
          {%- render 'icon', name: 'magnifying-glass' -%}
          {{ 'search.page.submit' | t }}
        </button>
      </form>

      {%- if search.performed -%}
        <p class="search-page__count body-5" role="status">
          {{ 'search.page.count_html' | t: count: search.results_count, terms: terms_escaped }}
        </p>
      {%- endif -%}
    </header>

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by 24 -%}
        {%- liquid
          assign product_results = search.results | where: 'object_type', 'product'
          assign other_results = search.results | where: 'object_type', 'page'
          assign article_results = search.results | where: 'object_type', 'article'
        -%}

        {%- if product_results.size > 0 -%}
          <ul class="product-grid search-page__grid" role="list">
            {%- for product in product_results -%}
              <li class="product-grid__item">
                {%- render 'product-card', product: product, sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw', heading_tag: 'h2' -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if other_results.size > 0 or article_results.size > 0 -%}
          <div class="search-page__other">
            <h2 class="caption-3 search-page__other-heading">{{ 'search.page.pages_articles' | t }}</h2>
            <ul class="search-page__rows" role="list">
              {%- for item in other_results -%}
                <li>
                  <a href="{{ item.url }}" class="search-row">
                    <span class="caption-4 text-muted">{{ 'search.page.page_label' | t }}</span>
                    <span class="title-2">{{ item.title }}</span>
                    {%- render 'icon', name: 'arrow-right' -%}
                  </a>
                </li>
              {%- endfor -%}
              {%- for item in article_results -%}
                <li>
                  <a href="{{ item.url }}" class="search-row">
                    <span class="caption-4 text-muted">{{ 'search.page.article_label' | t }}</span>
                    <span class="title-2">{{ item.title }}</span>
                    {%- render 'icon', name: 'arrow-right' -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="search-page__pagination" aria-label="{{ 'search.page.pagination' | t }}">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="button button--secondary">{{ 'search.page.previous' | t }}</a>
            {%- endif -%}
            <span class="caption-2 text-muted">{{ 'search.page.page_of' | t: current: paginate.current_page, total: paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="button button--secondary">{{ 'search.page.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="search-page__empty">
        {%- if search.performed -%}
          <p class="heading-5">{{ 'search.page.none_title' | t: terms: terms_escaped }}</p>
          <p class="body-6 text-muted">{{ 'search.page.none_text' | t }}</p>
        {%- else -%}
          <p class="body-5 text-muted">{{ 'search.page.start_text' | t }}</p>
        {%- endif -%}
        <ul class="search-modal__chips" role="list">
          {%- assign popular = 'search.predictive.popular_terms' | t | split: ',' -%}
          {%- for term in popular -%}
            {%- assign term_clean = term | strip -%}
            <li><a href="{{ routes.search_url }}?q={{ term_clean | url_encode }}" class="search-modal__chip body-5">{{ term_clean }}</a></li>
          {%- endfor -%}
        </ul>
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'search.page.browse_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.search.name",
  "class": "section-search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "default": "scheme-kora"
    }
  ]
}
{% endschema %}
