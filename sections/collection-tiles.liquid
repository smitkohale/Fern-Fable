{%- comment -%}
  Shop by collection: up to 6 tiles, one per block. Desktop shows a staggered
  magazine row; phones get a swipeable row with the next tile peeking in.
  Each tile is one link. Hover and focus zoom the photo, draw the underline
  and nudge the arrow. Missing collections fall back to the block's own title.
{%- endcomment -%}

{{ 'section-collection-tiles.css' | asset_url | stylesheet_tag }}

<div class="collection-tiles full-width color-{{ section.settings.color_scheme }} section-space">
  <div class="page-width">
    <div class="collection-tiles__header" data-reveal="rise">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-tiles__heading heading-2" id="CollectionTilesHeading-{{ section.id }}">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="collection-tiles__all body-2">
          {{- section.settings.link_label -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  <ul
    class="collection-tiles__list"
    role="list"
    {% if section.settings.heading != blank %}
      aria-labelledby="CollectionTilesHeading-{{ section.id }}"
    {% endif %}
    data-reveal-group
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign title = block.settings.title | default: collection.title
        assign image = block.settings.image | default: collection.featured_image
        if collection != blank
          assign url = collection.url
        else
          assign url = routes.collections_url
        endif
        assign number = forloop.index | prepend: '0' | slice: -2, 2
      -%}
      <li class="collection-tiles__item" data-reveal="ink" {{ block.shopify_attributes }}>
        <a href="{{ url }}" class="collection-tile">
          <div class="collection-tile__media">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1100
                | image_tag:
                  widths: '360, 540, 720, 900, 1100',
                  sizes: '(min-width: 990px) 20vw, (min-width: 750px) 40vw, 72vw',
                  loading: 'lazy',
                  class: 'collection-tile__image',
                  alt: ''
              }}
            {%- else -%}
              {%- liquid
                assign placeholder_number = forloop.index0 | modulo: 6 | plus: 1
                assign placeholder = 'collection-' | append: placeholder_number
              -%}
              {{ placeholder | placeholder_svg_tag: 'collection-tile__placeholder' }}
            {%- endif -%}
            <span class="collection-tile__number caption-3" aria-hidden="true">{{ number }}</span>
          </div>

          <div class="collection-tile__info">
            <div class="collection-tile__text">
              <h3 class="collection-tile__title heading-4">{{ title }}</h3>
              {%- if block.settings.caption != blank -%}
                <p class="collection-tile__caption body-6 text-muted">{{ block.settings.caption }}</p>
              {%- elsif section.settings.show_count and collection.products_count > 0 -%}
                <p class="collection-tile__caption body-6 text-muted">
                  {{ 'sections.collection_tiles.count' | t: count: collection.products_count }}
                </p>
              {%- endif -%}
            </div>
            <span class="collection-tile__arrow" aria-hidden="true">
              {%- render 'icon', name: 'arrow-right' -%}
            </span>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.collection_tiles.name",
  "class": "section-collection-tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "default": "scheme-kora"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_tiles.heading",
      "default": "Start with a room"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.collection_tiles.link_label",
      "default": "All collections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.collection_tiles.link"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection_tiles.show_count",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_tiles.block_name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_tiles.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collection_tiles.title",
          "info": "t:sections.collection_tiles.title_info"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.collection_tiles.caption",
          "info": "t:sections.collection_tiles.caption_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_tiles.image",
          "info": "t:sections.collection_tiles.image_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_tiles.name",
      "blocks": [
        { "type": "collection", "settings": { "title": "Kitchen" } },
        { "type": "collection", "settings": { "title": "Table" } },
        { "type": "collection", "settings": { "title": "Bed" } },
        { "type": "collection", "settings": { "title": "Living" } },
        { "type": "collection", "settings": { "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
