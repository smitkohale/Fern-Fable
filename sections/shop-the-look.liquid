{%- comment -%}
  Shop the look (signature moment 3), "The Indigo Table".
  A styled photo with numbered dots; each dot opens a small product card with
  quick add. Beside it, the same products as a numbered list with a total and
  one button that adds every included piece at once (items[] form, works
  without JavaScript). The list is the accessible way in; the dots add to it.
  Blocks: one per product. "Include in the whole look" leaves gift boxes out.
{%- endcomment -%}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'section-shop-the-look.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shop-the-look.js' | asset_url }}" type="module"></script>
<script src="{{ 'quick-add.js' | asset_url }}" type="module"></script>

{%- liquid
  assign look_total = 0
  assign look_count = 0
  assign look_sold_out = 0
  for block in section.blocks
    if block.settings.product == blank
      continue
    endif
    if block.settings.include_in_look
      if block.settings.product.available
        assign look_total = look_total | plus: block.settings.product.selected_or_first_available_variant.price
        assign look_count = look_count | plus: 1
      else
        assign look_sold_out = look_sold_out | plus: 1
      endif
    endif
  endfor
-%}

<shop-the-look class="look full-width color-{{ section.settings.color_scheme }} section-space">
  <div class="look__inner page-width">
    <div class="look__media" data-reveal="ink">
      <div class="look__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '600, 900, 1200, 1600, 2000',
              sizes: '(min-width: 990px) 60vw, 100vw',
              loading: 'lazy',
              class: 'look__image'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'look__placeholder' }}
        {%- endif -%}

        {%- assign dot_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign dot_number = dot_number | plus: 1
            assign card_id = 'LookCard-' | append: section.id | append: '-' | append: forloop.index
            assign side = 'right'
            if block.settings.x > 55
              assign side = 'left'
            endif
          -%}
          <div
            class="look__hotspot look__hotspot--{{ side }}{% if block.settings.y > 60 %} look__hotspot--up{% endif %}"
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
            data-hotspot="{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="look__dot caption-3"
              aria-expanded="false"
              aria-controls="{{ card_id }}"
              data-dot
            >
              <span aria-hidden="true">{{ dot_number }}</span>
              <span class="visually-hidden">{{ 'sections.shop_the_look.show_product' | t: title: product.title }}</span>
            </button>

            <div class="look__card color-{{ section.settings.card_color_scheme }}" id="{{ card_id }}" hidden data-card>
              <div class="look__card-body">
                <a href="{{ product.url }}" class="look__card-media" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 240
                      | image_tag: widths: '120, 240', sizes: '96px', loading: 'lazy', alt: ''
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'look__card-placeholder' }}
                  {%- endif -%}
                </a>
                <div class="look__card-info">
                  <p class="look__card-title title-4">
                    <a href="{{ product.url }}" id="{{ card_id }}-title">{{ product.title }}</a>
                  </p>
                  <p class="body-6">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="text-accent">{{ product.price | money_without_trailing_zeros }}</span>
                      <s class="text-muted">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                    {%- else -%}
                      {{ product.price | money_without_trailing_zeros }}
                    {%- endif -%}
                  </p>
                </div>
                <button type="button" class="look__card-close" data-close aria-label="{{ 'sections.shop_the_look.close' | t }}">
                  {%- render 'icon', name: 'x' -%}
                </button>
              </div>
              {%- if product.available -%}
                <div class="look__card-actions">
                  {%- render 'quick-add', product: product, card_id: card_id -%}
                </div>
              {%- else -%}
                <p class="look__card-sold-out body-6 text-muted">{{ 'products.card.sold_out' | t }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="look__content" data-reveal="rise">
      {%- if section.settings.caption != blank -%}
        <p class="caption-3 text-muted">{{ section.settings.caption }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="look__heading heading-2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="body-3 text-muted">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if dot_number > 0 -%}
        <ol class="look__list" role="list">
          {%- assign item_number = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product == blank -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign item_number = item_number | plus: 1 -%}
            <li class="look__item" data-item="{{ forloop.index }}">
              <span class="look__item-number caption-3" aria-hidden="true">{{ item_number }}</span>
              <a href="{{ product.url }}" class="look__item-link body-5">{{ product.title }}</a>
              <span class="look__item-price body-6">
                {%- if product.available -%}
                  {{ product.price | money_without_trailing_zeros }}
                {%- else -%}
                  {{ 'products.card.sold_out' | t }}
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>

        {%- if look_count > 0 -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="look__form" data-look-form>
            {%- assign item_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- assign product = block.settings.product -%}
              {%- if product == blank or block.settings.include_in_look == false or product.available == false -%}
                {%- continue -%}
              {%- endif -%}
              <input type="hidden" name="items[{{ item_index }}][id]" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="items[{{ item_index }}][quantity]" value="1">
              {%- assign item_index = item_index | plus: 1 -%}
            {%- endfor -%}

            <p class="look__total">
              <span class="body-6 text-muted">{{ 'sections.shop_the_look.total' | t: count: look_count }}</span>
              <span class="look__total-price heading-4">{{ look_total | money_without_trailing_zeros }}</span>
            </p>

            <button
              type="submit"
              class="button look__button"
              data-label-adding="{{ 'products.quick_add.adding' | t }}"
              data-label-added="{{ 'sections.shop_the_look.added' | t }}"
              data-label-announce="{{ 'sections.shop_the_look.announce' | t: count: look_count }}"
            >
              {%- render 'icon', name: 'handbag' -%}
              <span data-label>{{ section.settings.button_label }}</span>
            </button>
            {%- if look_sold_out > 0 -%}
              <p class="body-6 text-muted">{{ 'sections.shop_the_look.some_sold_out' | t }}</p>
            {%- endif -%}
            <p class="look__status body-6" role="status" hidden data-look-status></p>
          </form>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</shop-the-look>

{% schema %}
{
  "name": "t:sections.shop_the_look.name",
  "class": "section-shop-the-look",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "default": "scheme-kora-2"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:sections.shop_the_look.card_color_scheme",
      "default": "scheme-kora"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.shop_the_look.image",
      "info": "t:sections.shop_the_look.image_info"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.shop_the_look.caption",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shop_the_look.heading",
      "default": "The Indigo Table"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.shop_the_look.text",
      "default": "Runner, napkins, placemats and coasters, styled for six."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.shop_the_look.button_label",
      "default": "Add the whole look"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:sections.shop_the_look.hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shop_the_look.product"
        },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.shop_the_look.x",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.shop_the_look.y",
          "default": 50
        },
        {
          "type": "checkbox",
          "id": "include_in_look",
          "label": "t:sections.shop_the_look.include_in_look",
          "info": "t:sections.shop_the_look.include_in_look_info",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_the_look.name",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 30, "y": 55 } },
        { "type": "hotspot", "settings": { "x": 55, "y": 35 } },
        { "type": "hotspot", "settings": { "x": 72, "y": 65 } }
      ]
    }
  ]
}
{% endschema %}
