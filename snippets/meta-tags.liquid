<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#1C2754">

{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- else -%}
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign fallback_description = 'general.meta.description' | t
  assign og_description = page_description | default: shop.description | default: fallback_description
  assign share_image = page_image | default: settings.share_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if share_image -%}
  <meta
    property="og:image"
    content="http:{{ share_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ share_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ share_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- liquid
    # The store name and page_title can each arrive escaped or not ("&" or "&amp;"),
    # so compare the decoded forms. The home page title is the store name already.
    assign shop_name_plain = shop.name | replace: '&amp;', '&'
    assign page_title_plain = page_title | replace: '&amp;', '&'
    assign title_has_shop = false
    if request.page_type == 'index' or page_title_plain contains shop_name_plain
      assign title_has_shop = true
    endif
  -%}
  {%- unless title_has_shop %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>
