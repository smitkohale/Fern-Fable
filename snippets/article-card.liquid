{%- doc -%}
  Article card for the blog list and "More hosting notes": image, tag and
  reading time, title, excerpt. The whole card is one link (the title).

  @param {article} article - The article.
  @param {boolean} [featured] - Large layout for the newest article.
  @param {string} [sizes] - The sizes attribute for the image.

  @example
  {% render 'article-card', article: article, featured: true %}
{%- enddoc -%}

{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  assign sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
-%}

<article class="article-card{% if featured %} article-card--featured{% endif %}">
  <div class="article-card__media">
    {%- if article.image -%}
      {{
        article.image
        | image_url: width: 1400
        | image_tag:
          widths: '480, 720, 960, 1200, 1400',
          sizes: sizes,
          loading: 'lazy',
          class: 'article-card__image',
          alt: article.image.alt
      }}
    {%- else -%}
      <div class="image-text__motif article-card__motif" aria-hidden="true">
        <svg viewBox="0 0 120 120" focusable="false">
          <rect x="10" y="10" width="100" height="100" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M60 96c2-16 1-34-1-56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <g fill="currentColor">
            <ellipse cx="49" cy="82" rx="11" ry="3.8" transform="rotate(-30 49 82)"/>
            <ellipse cx="71" cy="80" rx="11" ry="3.8" transform="rotate(30 71 80)"/>
            <ellipse cx="50" cy="67" rx="10" ry="3.4" transform="rotate(-34 50 67)"/>
            <ellipse cx="69" cy="65" rx="10" ry="3.4" transform="rotate(34 69 65)"/>
            <ellipse cx="59" cy="38" rx="2.8" ry="5.5"/>
          </g>
        </svg>
      </div>
    {%- endif -%}
  </div>
  <div class="article-card__info">
    <p class="article-card__meta caption-3 text-muted">
      {%- if article.tags.size > 0 -%}<span>{{ article.tags.first }}</span> · {% endif -%}
      <span>{{ 'blog.read_time' | t: count: minutes }}</span>
    </p>
    <h3 class="article-card__title {% if featured %}heading-2{% else %}heading-4{% endif %}">
      <a href="{{ article.url }}" class="article-card__link">{{ article.title }}</a>
    </h3>
    {%- if article.excerpt != blank or featured -%}
      <p class="article-card__excerpt body-6 text-muted">
        {{- article.excerpt | default: article.content | strip_html | truncatewords: 26 -}}
      </p>
    {%- endif -%}
    <p class="caption-2 text-muted">{{ article.published_at | time_tag: format: 'date' }}</p>
  </div>
</article>
