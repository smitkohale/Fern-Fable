{%- doc -%}
  Design tokens from DESIGN.md as CSS custom properties, the self hosted
  font faces, and one class per colour scheme (`.color-<scheme id>`).
  Rendered once in the <head> of layout/theme.liquid and layout/password.liquid.
{%- enddoc -%}

{% style %}
  /* Fraunces and Manrope: SIL Open Font License 1.1. Trimmed to the axes the theme uses. */
  @font-face {
    font-family: 'Fraunces';
    src: url('{{ 'fraunces-display.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Fraunces';
    src: url('{{ 'fraunces-display-rupee.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
    unicode-range: U+20B9;
  }
  @font-face {
    font-family: 'Manrope';
    src: url('{{ 'manrope-body.woff2' | asset_url }}') format('woff2');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Manrope';
    src: url('{{ 'manrope-body-rupee.woff2' | asset_url }}') format('woff2');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
    unicode-range: U+20B9;
  }

  :root {
    /* Brand palette (DESIGN.md section 2) */
    --color-kora: #f5efe4;
    --color-kora-2: #ebe2d1;
    --color-line: #d6cbb6;
    --color-ink: #1a1a22;
    --color-muted: #5d5a66;
    --color-indigo: #1c2754;
    --color-indigo-deep: #121a3b;
    --color-madder: #a3302a;
    --color-turmeric: #e3a72f;
    --color-forest: #2e5b41;
    --color-success: #2e5b41;

    /* Fonts (DESIGN.md section 3) */
    --font-display: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    --font-body: 'Manrope', 'Segoe UI', system-ui, sans-serif;
    --font-display-variation: 'SOFT' 100, 'WONK' 0;

    /* Type scale: size and paired line height (skill B1) */
    --text-xs: 0.75rem;   --leading-xs: 1rem;
    --text-sm: 0.875rem;  --leading-sm: 1.25rem;
    --text-base: 1rem;    --leading-base: 1.5rem;
    --text-lg: 1.125rem;  --leading-lg: 1.75rem;
    --text-xl: 1.25rem;   --leading-xl: 1.75rem;
    --text-2xl: 1.5rem;   --leading-2xl: 2rem;
    --text-3xl: 1.875rem; --leading-3xl: 2.25rem;
    --text-4xl: 2.25rem;  --leading-4xl: 2.5rem;
    --text-5xl: 3rem;     --leading-5xl: 1;
    --text-6xl: 3.75rem;  --leading-6xl: 1;
    --text-7xl: 4.5rem;   --leading-7xl: 1;
    --text-8xl: 6rem;     --leading-8xl: 1;
    --text-9xl: 8rem;     --leading-9xl: 1;

    /* Spacing (skill B2, nothing else allowed) */
    --space-0: 0;
    --space-25: 2px;
    --space-50: 4px;
    --space-75: 8px;
    --space-100: 12px;
    --space-200: 16px;
    --space-300: 24px;
    --space-400: 32px;
    --space-500: 40px;
    --space-600: 48px;
    --space-700: 64px;
    --space-800: 80px;
    --space-900: 96px;

    /* Layout */
    --page-width: {{ settings.page_width | default: 1440 }}px;
    --page-gutter: var(--space-200);
    --section-space: var(--space-700);
    --text-column: 680px;

    /* Radius (skill B3) */
    --radius-none: 0;
    --radius-sm: 4px;
    --radius-lg: 8px;
    --radius-full: 9999px;

    /* Borders and shadow */
    --border: 1px solid var(--color-line);
    --shadow-float: 0 8px 24px rgb(18 26 59 / 0.12);

    /* Motion (DESIGN.md section 8) */
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-press: cubic-bezier(0.65, 0, 0.35, 1);
    --dur-hover: 300ms;
    --dur-move: 500ms;
    --dur-reveal: 700ms;
    --dur-hero: 1400ms;

    /* Interaction */
    --tap-target: 44px;
    --header-offset: var(--space-100);
    --header-height: calc(var(--space-700) + var(--header-offset));
  }

  @media (min-width: 750px) {
    :root {
      --page-gutter: var(--space-300);
    }
  }

  @media (min-width: 990px) {
    :root {
      --page-gutter: var(--space-600);
      --section-space: var(--space-900);
    }
  }

  {% for scheme in settings.color_schemes -%}
    {%- if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-surface: {{ scheme.settings.surface }};
      --color-foreground: {{ scheme.settings.text }};
      --color-heading: {{ scheme.settings.heading }};
      --color-muted-text: {{ scheme.settings.muted }};
      --color-accent: {{ scheme.settings.accent }};
      --color-button: {{ scheme.settings.button }};
      --color-button-text: {{ scheme.settings.button_label }};
      --color-button-hover: {{ scheme.settings.button_hover }};
      --color-secondary-button: {{ scheme.settings.secondary_button }};
      --color-border: {{ scheme.settings.border }};
      --color-focus: {{ scheme.settings.focus }};
    }
  {% endfor %}
{% endstyle %}
